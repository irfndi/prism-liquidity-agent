{
  "name": "prism-liquidity-agent",
  "version": "0.2.32",
  "description": "Autonomous liquidity agent for Solana pools (currently Meteora DLMM)",
  "keywords": [
    "ai-agent",
    "autonomous",
    "claude",
    "defi",
    "dlmm",
    "effect-ts",
    "liquidity",
    "meteora",
    "rebalancing",
    "solana"
  ],
  "license": "MIT",
  "bin": {
    "prism": "./scripts/prism.sh"
  },
  "type": "module",
  "scripts": {
    "start": "bun run start:engine",
    "dev": "bun run --watch cli/index.ts dev",
    "start:engine": "bun cli/index.ts dev",
    "build": "bun tsdown",
    "setup": "bun cli/index.ts setup",
    "setup:env": "bun run scripts/postinstall.js",
    "postinstall": "bun run scripts/postinstall.js",
    "backtest": "bun cli/index.ts backtest",
    "test": "bun --bun vitest run",
    "test:watch": "bun --bun vitest",
    "lint": "tsc --noEmit && oxlint engine ops bench cli scripts",
    "format": "oxfmt --write engine ops bench cli scripts",
    "format:check": "oxfmt --check engine ops bench cli scripts",
    "coverage": "bun --bun vitest run --coverage",
    "prepare": "effect-tsgo patch --oxlint || echo \"warning: effect-tsgo patch failed (unsupported platform or version mismatch) — type-aware effect lint disabled\""
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@coral-xyz/anchor": "^0.31.0",
    "@meteora-ag/dlmm": "^1.9.14",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.4",
    "@xenova/transformers": "^2.17.2",
    "bs58": "^4.0.1",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "effect": "4.0.0-rc.108",
    "semver": "^7.8.5",
    "sqlite-vec": "^0.1.9"
  },
  "devDependencies": {
    "@effect/tsgo": "0.36.5",
    "@oxlint/plugins": "1.79.0",
    "@types/node": "^26.1.2",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-istanbul": "^4.1.10",
    "bigint-buffer": "^1.1.5",
    "bun-types": "1.4.0",
    "fast-check": "^4.9.0",
    "oxfmt": "^0.62.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "tsdown": "^0.22.14",
    "typescript": "7.0.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "typescript": "$typescript"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.0"
}
