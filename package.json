{
  "name": "prism-liquidity-agent",
  "version": "0.2.46",
  "description": "Autonomous liquidity agent for Solana pools (currently Meteora DLMM)",
  "keywords": [
    "ai-agent",
    "autonomous",
    "claude",
    "defi",
    "dlmm",
    "effect-ts",
    "liquidity",
    "meteora",
    "rebalancing",
    "solana"
  ],
  "license": "MIT",
  "bin": {
    "prism": "./scripts/prism.sh"
  },
  "type": "module",
  "scripts": {
    "start": "bun run start:engine",
    "dev": "bun run --watch cli/index.ts dev",
    "start:engine": "bun cli/index.ts dev",
    "compile": "bun scripts/compile-binary.ts",
    "compile:prism": "bun scripts/compile-binary.ts prism",
    "compile:prismd": "bun scripts/compile-binary.ts prismd",
    "build": "bun tsdown",
    "setup": "bun cli/index.ts setup",
    "setup:env": "bun run scripts/postinstall.js",
    "postinstall": "bun run scripts/postinstall.js",
    "backtest": "bun cli/index.ts backtest",
    "test": "bun --bun vitest run",
    "test:watch": "bun --bun vitest",
    "lint": "tsc --noEmit && oxlint engine ops bench cli scripts",
    "format": "oxfmt --write engine ops bench cli scripts",
    "format:check": "oxfmt --check engine ops bench cli scripts",
    "check:toolchain": "bun run scripts/check-toolchain.ts",
    "coverage": "bun --bun vitest run --coverage",
    "prepare": "effect-tsgo patch --oxlint || echo \"warning: effect-tsgo patch failed (unsupported platform or version mismatch) — type-aware effect lint disabled\"",
    "verify": "bash scripts/verify.sh",
    "verify:bend": "cd native/bend && ${BEND_BIN:-$HOME/.bend/bin/bend} PROOF.bend",
    "verify:tla": "bash scripts/tla-verify.sh"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "@coral-xyz/anchor": "^0.31.0",
    "@meteora-ag/dlmm": "^1.9.14",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.4",
    "@xenova/transformers": "^2.17.2",
    "bs58": "^6.0.0",
    "chalk": "^6.0.1",
    "commander": "^15.1.0",
    "dotenv": "^18.0.10",
    "effect": "4.1.6",
    "semver": "^7.8.6",
    "sqlite-vec": "^0.1.9"
  },
  "devDependencies": {
    "@effect/tsgo": "0.73.4",
    "@oxlint/plugins": "1.94.0",
    "@types/node": "^26.6.11",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-istanbul": "^5.1.2",
    "bigint-buffer": "^1.1.5",
    "bun-types": "1.4.5",
    "fast-check": "^4.11.0",
    "oxfmt": "^0.80.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2008",
    "tsdown": "^0.23.7",
    "typescript": "7.0.2",
    "vitest": "^5.1.2"
  },
  "overrides": {
    "typescript": "$typescript"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.5"
}
