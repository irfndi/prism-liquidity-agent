{
  "name": "prism-liquidity-agent",
  "version": "0.2.44",
  "description": "Autonomous liquidity agent for Solana pools (currently Meteora DLMM)",
  "keywords": [
    "ai-agent",
    "autonomous",
    "claude",
    "defi",
    "dlmm",
    "effect-ts",
    "liquidity",
    "meteora",
    "rebalancing",
    "solana"
  ],
  "license": "MIT",
  "bin": {
    "prism": "./scripts/prism.sh"
  },
  "type": "module",
  "scripts": {
    "start": "bun run start:engine",
    "dev": "bun run --watch cli/index.ts dev",
    "start:engine": "bun cli/index.ts dev",
    "compile": "bun scripts/compile-binary.ts",
    "compile:prism": "bun scripts/compile-binary.ts prism",
    "compile:prismd": "bun scripts/compile-binary.ts prismd",
    "build": "bun tsdown",
    "setup": "bun cli/index.ts setup",
    "setup:env": "bun run scripts/postinstall.js",
    "postinstall": "bun run scripts/postinstall.js",
    "backtest": "bun cli/index.ts backtest",
    "test": "bun --bun vitest run",
    "test:watch": "bun --bun vitest",
    "typecheck": "tsrs --noEmit --fast",
    "typecheck:tsc": "tsc --noEmit",
    "lint": "bun run typecheck && oxlint engine ops bench cli scripts",
    "format": "oxfmt --write engine ops bench cli scripts",
    "format:check": "oxfmt --check engine ops bench cli scripts",
    "coverage": "bun --bun vitest run --coverage",
    "prepare": "effect-tsgo patch --oxlint || echo \"warning: effect-tsgo patch failed (unsupported platform or version mismatch) — type-aware effect lint disabled\""
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@coral-xyz/anchor": "^0.32.1",
    "@huggingface/transformers": "^4.3.2",
    "@meteora-ag/dlmm": "^1.9.14",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "bs58": "^6.0.0",
    "commander": "^15.0.0",
    "dotenv": "^18.0.9",
    "effect": "4.1.0",
    "semver": "^7.8.5",
    "sqlite-vec": "^0.1.9"
  },
  "devDependencies": {
    "@effect/tsgo": "0.63.0",
    "@oxlint/plugins": "1.90.0",
    "@types/node": "^26.6.6",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-istanbul": "^5.0.5",
    "bigint-buffer": "^1.1.5",
    "bun-types": "1.4.4",
    "fast-check": "^4.10.2",
    "oxfmt": "^0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "tsdown": "^0.23.4",
    "tsrs": "^0.20.1-ts7.1.0-beta",
    "typescript": "7.0.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "typescript": "$typescript"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.4"
}
