# paper-runner — paper-aggressive + runner lane (no rotation)
# One lane trial: MARKET_SCAN_RUNNER only, halt + pool-PnL kill switch +
# fee-density + drift floor.
# Apply as: set -a; source profiles/paper-runner.env; set +a; prism dev
# Promote: keep ROTATION off until 100+ paper closes stay halt-green.
SCAN_INTERVAL_MS=60000
MARKET_SCAN_ENABLED=true
MARKET_SCAN_REFRESH_INTERVAL_MS=600000
MARKET_SCAN_UNIVERSE_PAGES=3
MARKET_SCAN_UNIVERSE_SORT=fee
MARKET_SCAN_MIN_TVL_USD=50000
MARKET_SCAN_MIN_FEE_APR=100
MARKET_SCAN_TOP_K=40
MARKET_SCAN_MAX_POOLS=80
MARKET_SCAN_MIN_HOLDERS=1000
MARKET_SCAN_REQUIRE_RENOUNCED_MINT=true
MARKET_SCAN_MIN_POOL_AGE_HOURS=24
MARKET_SCAN_MIN_BIN_STEP=20
MARKET_SCAN_MAX_BIN_STEP=120
# Runner lane only — rotation OFF
MARKET_SCAN_RUNNER_ENABLED=true
MARKET_SCAN_RUNNER_MIN_FEE_APR=500
MARKET_SCAN_RUNNER_MIN_DRIFT_BINS=-8
MARKET_SCAN_RUNNER_CONFIRM_CYCLES=2
MARKET_SCAN_ROTATION_ENABLED=false
MARKET_SCAN_ROTATION_ARM_MS=1800000
# Other high-yield lanes stay OFF until measured
HOT_WINDOW_ENABLED=false
LAUNCH_SCAN_ENABLED=false
LAUNCH_EXECUTION_ENABLED=false
FALLEN_ANGEL_ENABLED=false
# Speed dials, still guarded
MIN_REBALANCE_INTERVAL_MS=14400000
TAKE_PROFIT_ENABLED=true
TAKE_PROFIT_PCT=0.15
MAX_OPEN_POSITIONS=5
MAX_POSITIONS_PER_POOL=1
MAX_PER_POOL_ALLOCATION_PCT=0.30
MAX_ENTRY_SIZE_USD=500
ENTRY_RANGE_HALF_WIDTH_BINS=0
VOLATILITY_ADAPTIVE_RANGES=true
MIN_RANGE_HALF_WIDTH_PCT=5
MAX_REBALANCE_RANGE_BINS=60
HARVEST_MIN_NET_USD=1
HARVEST_MAX_COST_PCT=0.15
FEE_CLAIM_INTERVAL_MS=86400000
REALIZED_PNL_HALT_ENABLED=true
REALIZED_PNL_HALT_WINDOW=100
REALIZED_PNL_HALT_THRESHOLD_USD=-20
POOL_PNL_KILL_SWITCH_ENABLED=true
POOL_PNL_KILL_SWITCH_MIN_CLOSED_POSITIONS=10
POOL_PNL_KILL_SWITCH_THRESHOLD_USD=-15
POOL_PNL_KILL_SWITCH_COOLDOWN_MS=172800000
FEE_DENSITY_COOLDOWNS=true
FEE_DENSITY_COOLDOWN_MIN_MS=3600000
FEE_DENSITY_HIGH_PCT=0.005
FEE_DENSITY_LOW_PCT=0.0005
MIN_REENTRY_COOLDOWN_MS=7200000
OOR_COOLDOWN_MS=14400000
REPEAT_OOR_COOLDOWN_MS=43200000
MAX_OOR_COOLDOWN_EXITS=3
ENABLE_POOL_DISCOVERY=false
RPC_MIN_INTERVAL_MS=100
ENABLE_SNAPSHOT_CAPTURE=true
IL_PROTECTION_ENABLED=true
MIN_FEE_IL_RATIO=1.2
VOLUME_AUTH_THRESHOLD=0.70
CONFIDENCE_THRESHOLD=0.65
MARKET_SCAN_MAX_NEGATIVE_DRIFT_BINS=-8
